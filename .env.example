# TiDB connection string (TiDB Cloud → Connect → "Prisma" or "General").
# TLS is switched on automatically for *.tidbcloud.com hosts; for any other
# host that needs TLS add ?sslaccept=strict to the end of the URL.
DATABASE_URL="mysql://USER:PASSWORD@HOST:4000/DATABASE?sslaccept=strict"

# Secret used to sign login sessions. Must be at least 32 random characters.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=""

# Optional: the time zone used for "today", due dates and overdue checks.
APP_TIMEZONE="Africa/Johannesburg"
